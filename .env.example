# Set through hosting settings; this file is documentation, not automatically loaded.
# Never commit a populated .env file. No real credentials belong here.
DEMO_MODE=0
COOKIE_SECURE=1
# Enable only behind a trusted proxy that overwrites/appends X-Forwarded-For.
TRUST_PROXY=0
PORT=3000
# Choose one storage option:
DATABASE_PATH=/var/data/shaadi.sqlite3
DATABASE_URL=
PUBLIC_BASE_URL=
# Twilio Verify: required for live sign-in (India +91 mobile numbers).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# WhatsApp Cloud API: approved invitation template with 3 body text parameters.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_API_VERSION=v23.0
WHATSAPP_RSVP_BUTTONS=0
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Razorpay: use TEST keys first; webhook secret is independently configured.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Only for protecting the optional demo; omit for verified-user live access.
DEMO_ACCESS_PASSWORD=
