# Set through hosting settings; this file is documentation, not automatically loaded.
# Never commit a populated .env file. No real credentials belong here.
APP_MODE=user
COOKIE_SECURE=1
# Enable only behind a trusted proxy that overwrites/appends X-Forwarded-For.
TRUST_PROXY=0
PORT=3000
# Choose one storage option:
DATABASE_PATH=/var/data/shaadi.sqlite3
DATABASE_URL=
# Optional path to the Supabase CA certificate, if required by your project.
PGSSLROOTCERT=system
PUBLIC_BASE_URL=
# Optional legacy phone sign-in only. Google sign-in does not need Twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# WhatsApp Cloud API: approved invitation template with 3 body text parameters.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_API_VERSION=v23.0
WHATSAPP_RSVP_BUTTONS=0
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Razorpay: use TEST keys first; webhook secret is independently configured.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional Memories photo-byte budgets in MB. Provider database capacity still applies.
MEMORIES_ALBUM_MB=150
MEMORIES_TOTAL_MB=300

# Optional live AI help. Keep the key on the server, never in frontend files.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional mashup audio-byte budgets in MB; files are stored privately in the database.
SONG_AUDIO_EVENT_MB=75
SONG_AUDIO_TOTAL_MB=150
# Google sign-in through Supabase Auth (no SMS provider required).
AUTH_PROVIDER=google
SUPABASE_URL=https://oyluxvnfhchlogufsyaj.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Legacy anon key is also accepted as SUPABASE_ANON_KEY. Never use a service-role key.
